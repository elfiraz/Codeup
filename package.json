{
  "name": "codeup",
  "version": "1.0.0",
  "description": "Ürün ve Tedarikçi Yönetim Sistemi — ABICS CodeUp",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^8",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana",
          "vcap": {
            "name": "hana"
          },
          "credentials": {}
        }
      }
    },
    "features": {
      "assert_integrity": false
    }
  }
}
