{
  "_version": "1.58.0",
  "sap.app": {
    "id": "com.abics.codeup",
    "type": "application",
    "title": "Ürün ve Tedarikçi Yönetim Sistemi",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "mainService": {
        "uri": "/catalog/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "fullWidth": true
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.abics.codeup.view.App",
      "type": "XML",
      "async": true,
      "id": "appView"
    },
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": { "lazy": false },
        "sap.tnt": {},
        "sap.ui.layout": {},
        "sap.ui.table": {},
        "sap.ui.unified": {}
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "contentDensities": { "compact": true, "cozy": true },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "groupId": "$auto",
          "updateGroupId": "batchGroup"
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.abics.codeup.i18n.i18n",
          "supportedLocales": ["", "tr", "en"],
          "fallbackLocale": "tr"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.abics.codeup.view.pages",
        "controlId": "pageContainer",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "name": "home",                 "pattern": "",                     "target": "home" },
        { "name": "materials",            "pattern": "materials",            "target": "materials" },
        { "name": "suppliers",            "pattern": "suppliers",            "target": "suppliers" },
        { "name": "purchasingMasterData", "pattern": "purchasingMasterData", "target": "purchasingMasterData" }
      ],
      "targets": {
        "home":                 { "viewName": "Home",                 "viewLevel": 1 },
        "materials":            { "viewName": "Materials",            "viewLevel": 2 },
        "suppliers":            { "viewName": "Suppliers",            "viewLevel": 2 },
        "purchasingMasterData": { "viewName": "PurchasingMasterData", "viewLevel": 2 }
      }
    }
  }
}
