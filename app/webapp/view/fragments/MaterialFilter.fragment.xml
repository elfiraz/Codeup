<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <ViewSettingsDialog title="Malzeme Filtrele / Sırala"
    confirm=".onFilterConfirm" cancel=".onFilterConfirm">
    <filterItems>
      <ViewSettingsFilterItem text="Fiyat" key="FiyatAralik">
        <items>
          <ViewSettingsItem text="0 - 10.000" key="PRICE_0_10000"/>
          <ViewSettingsItem text="10.000 - 50.000" key="PRICE_10000_50000"/>
          <ViewSettingsItem text="50.000+" key="PRICE_50000_PLUS"/>
        </items>
      </ViewSettingsFilterItem>
      <ViewSettingsFilterItem text="Stok" key="StokAralik">
        <items>
          <ViewSettingsItem text="0 - 10" key="STOCK_0_10"/>
          <ViewSettingsItem text="10 - 100" key="STOCK_10_100"/>
          <ViewSettingsItem text="100+" key="STOCK_100_PLUS"/>
        </items>
      </ViewSettingsFilterItem>
      <ViewSettingsFilterItem text="Tedarikçi" key="TedarikciNo"/>
      <ViewSettingsFilterItem text="Satınalmacı" key="SatinalmaGrubu"/>
      <ViewSettingsFilterItem text="Döviz" key="Doviz">
        <items>
          <ViewSettingsItem text="TRY" key="TRY"/>
          <ViewSettingsItem text="USD" key="USD"/>
          <ViewSettingsItem text="EUR" key="EUR"/>
          <ViewSettingsItem text="GBP" key="GBP"/>
        </items>
      </ViewSettingsFilterItem>
    </filterItems>
    <sortItems>
      <ViewSettingsItem text="Malzeme No"    key="MalzemeNo"    selected="true"/>
      <ViewSettingsItem text="Malzeme Adı"   key="MalzemeTanimi"/>
      <ViewSettingsItem text="Fiyat"         key="Fiyat"/>
      <ViewSettingsItem text="Stok"          key="Stok"/>
    </sortItems>
  </ViewSettingsDialog>
</core:FragmentDefinition>
